{
  "name": "@anvesx/connector-kit",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/tests/support/fake.d.ts",
      "default": "./dist/tests/support/fake.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "mutation": "stryker run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@anvesx/core-types": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvesx/company-brain.git",
    "directory": "features/connector-kit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "license": "MIT"
}
