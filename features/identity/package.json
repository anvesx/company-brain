{
  "name": "@anvesx/identity",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/policy/breached.txt dist/policy/breached.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --exclude '**/tests/scale/**'",
    "scale": "vitest run --config ../../vitest.config.ts --no-file-parallelism --reporter=verbose tests/scale",
    "e2e": "PLAYWRIGHT=1 vitest run --config ../../vitest.config.ts --no-file-parallelism tests/e2e",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@hono/node-server": "^2.1.5",
    "@simplewebauthn/browser": "13.3.0",
    "@zxcvbn-ts/core": "3.0.4",
    "@zxcvbn-ts/language-common": "3.0.4",
    "better-auth": "1.7.18",
    "hono": "^4.13.16",
    "jose": "6.2.14",
    "kysely": "0.29.8",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "fast-check": "4.10.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvesx/company-brain.git",
    "directory": "features/identity"
  },
  "license": "MIT",
  "private": true
}
