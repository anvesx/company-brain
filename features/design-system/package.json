{
  "name": "@anvesx/design-system",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/src/tokens/index.js",
      "types": "./dist/src/tokens/index.d.ts"
    },
    "./components": {
      "import": "./dist/src/components/index.js",
      "types": "./dist/src/components/index.d.ts"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --coverage --coverage.include='src/**/*.{ts,tsx}'",
    "mutation": "stryker run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "dependencies": {
    "hono": "^4.13.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvesx/company-brain.git",
    "directory": "features/design-system"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/culori": "4.0.1",
    "culori": "4.0.2",
    "fast-check": "4.10.2"
  }
}
